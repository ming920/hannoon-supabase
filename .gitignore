# ─── 환경변수 / 비밀값 ───
# (Supabase CLI 전용 env는 supabase/.gitignore에서 별도 관리)
.env
.env.*
!.env.example

# ─── Node / 패키지 (Edge Function 의존성 등) ───
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── 로그 / 임시 ───
*.log
logs/
tmp/
*.tmp

# ─── OMC 런타임/세션 상태 (프로젝트 스킬은 예외로 커밋) ───
# 주의: 부모 디렉터리를 통째로 무시하면 하위 예외(!)가 안 먹으므로 .omc/* 로 무시
.omc/*
!.omc/skills/
# 루트가 아닌 하위 경로의 .omc (예: supabase/migrations/.omc/)는 통째로 무시.
# 루트 .omc는 위 규칙(skills 예외)이 담당하므로 depth>=1 만 매칭한다.
*/**/.omc/

# ─── Claude 로컬/세션 상태 ───
.claude/settings.local.json
.claude/*.local.json
.claude/agent-memory/

# ─── 에디터 / IDE ───
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# ─── OS 생성 파일 ───
.DS_Store
Thumbs.db
desktop.ini

# ─── Python (스크립트/도구용) ───
__pycache__/
*.py[cod]
.venv/
venv/
